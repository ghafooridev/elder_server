generator client {
  provider      = "prisma-client-js"
  output        = "./generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

enum GenderEnum {
  MALE
  FEMALE
  NONE
}

enum RoleEnum {
  ADMIN
  ELDER
  RELATIVE
  CAREGIVER
}

enum CaregiverType {
  CAREGIVER
  NURSE
  DOCTOR
  PHYSIOTHERAPIST
  OTHER
}

model User {
  id              String     @id @default(cuid())
  firstName       String?
  lastName        String?
  avatar          String?
  nationalityCode String?
  mobileNumber    String?    @unique()
  email           String?    @unique()
  password        String?
  gender          GenderEnum @default(NONE)
  role            RoleEnum   @default(ELDER)
  dateOfBirth     DateTime?
  enabled         Boolean    @default(true)

  caregiver Caregiver?
  elder     Elder?
  relative  Relative?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mobileNumber])
  @@index([email])
}

model Elder {
  userId                   String   @id
  bloodType                String?
  medicalConditions        String[]
  allergies                String[]
  medications              String[]
  disability               String?
  mobilityStatus           String?
  cognitiveStatus          String?
  maritalStatus            String?
  occupation               String?
  languages                String[]
  religion                 String?
  dietaryNeeds             String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  relative Relative[]
}

model Caregiver {
  userId          String        @id
  caregiverType   CaregiverType
  specialization  String?
  licenseNumber   String?
  experienceYears Int?
  languages       String[]
  available       Boolean       @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Relative {
  userId              String @id
  relationshipToElder String

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  elderId String
  elder   Elder  @relation(fields: [elderId], references: [userId])

  @@index([elderId])
}
