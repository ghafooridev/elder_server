generator client {
  provider      = "prisma-client-js"
  output        = "./generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PRODUCT_DATABASE_URL")
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String?
  category    ProductCategory
  subcategory String?

  // Pricing
  price    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Inventory
  sku      String @unique
  stock    Int    @default(0)
  minStock Int    @default(0)
  maxStock Int?

  // Product details
  brand      String?
  model      String?
  dimensions String? // e.g., "10x5x3 cm"
  weight     Decimal? @db.Decimal(8, 2)
  color      String?
  material   String?

  // Elder care specific
  ageGroup             AgeGroup[]
  safetyRating         String?
  medicalGrade         Boolean    @default(false)
  prescriptionRequired Boolean    @default(false)

  // Media
  images    String[] // Array of image URLs
  videos    String[] // Array of video URLs
  documents String[] // Array of document URLs (manuals, certificates)

  // Status and visibility
  isActive   Boolean @default(true)
  isVisible  Boolean @default(true)
  isFeatured Boolean @default(false)

  // Shipping
  shippingWeight     Decimal? @db.Decimal(8, 2)
  shippingDimensions String?
  freeShipping       Boolean  @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reviews ProductReview[]
  orders  OrderItem[]

  @@map("products")
}

model ProductReview {
  id        String  @id @default(cuid())
  productId String
  userId    String
  rating    Int     @db.SmallInt // 1-5 stars
  title     String?
  comment   String?
  verified  Boolean @default(false) // Verified purchase
  helpful   Int     @default(0) // Helpful votes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_reviews")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum ProductCategory {
  MOBILITY_AIDS
  MEDICAL_EQUIPMENT
  DAILY_LIVING_AIDS
  SAFETY_SECURITY
  HEALTH_MONITORING
  COMFORT_WELLNESS
  NUTRITION_SUPPLEMENTS
  PERSONAL_CARE
  HOME_MODIFICATIONS
  EMERGENCY_RESPONSE
  MEDICATION_MANAGEMENT
  EXERCISE_THERAPY
}

enum AgeGroup {
  SENIOR_60_70
  SENIOR_70_80
  SENIOR_80_PLUS
  ALL_AGES
}
