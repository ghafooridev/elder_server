generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("REMINDER_DATABASE_URL")
}

enum REMINDER_STATUS {
  PENDING
  COMPLETED
  MISSED
}

enum REMINDER_TYPE {
  MEDICINE
  APPOINTMENT
  VITALS
  WORKOUT
  MEAL
  HYDRATION
  SLEEP
  WEIGHT
  OTHER
}

model Reminder {
  id          String          @id @default(cuid())
  title       String?
  description String?
  status      REMINDER_STATUS @default(PENDING)
  type        REMINDER_TYPE   @default(OTHER)
  date        DateTime?
  enabled     Boolean         @default(true)
  userId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}
