generator client {
  provider      = "prisma-client-js"
  output        = "./generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_GAME_DATABASE_URL")
}

model Game {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        GAME_TYPE
  publicPath  String   // relative path under apps/game/public, e.g., /games/memory/tangram/index.html
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



enum GAME_TYPE {
  CONCENTRATION
  MEMORY
  MOBILITY
  LOGIC
}
