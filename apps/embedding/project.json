{
  "name": "embedding",
  "root": "apps/embedding",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/embedding && . .venv/bin/activate && uvicorn main:app --reload --port 8001"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/embedding && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt"
      }
    }
  }
}
